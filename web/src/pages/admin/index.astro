---
import Layout from "../../layouts/Layout.astro";
import "../../styles/admin.css";

const API = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";
---

<Layout title="Administración — Inspirarte Espacio">
  <header class="top">
    <nav aria-label="Navegación de administración">
      <a class="logo" href="/" aria-label="Inspirarte Espacio — inicio"><img src="/inspirarte-logo-web.svg" alt="Inspirarte Espacio" /></a>
      <div class="links">
        <a href="/">Ver web</a>
        <button id="btn-salir" class="btn btn-sec hidden" style="padding: 10px 20px;">Salir</button>
      </div>
    </nav>
  </header>

  <main class="wrap admin-main">
    <section class="admin-section">
      <div class="admin-intro">
        <h1>Todo en un solo lugar.</h1>
        <p>Gestiona las reservas de mesa y las actividades de Inspirarte Espacio.</p>
      </div>

      <!-- LOGIN -->
      <div id="login-box" class="card admin-login">
        <h2>Bienvenido de nuevo</h2>
        <p>Ingresa con tu cuenta para ver el panel.</p>
        <form id="form-login" class="campo-grupo">
          <div>
            <label for="email">Correo</label>
            <input id="email" name="email" type="email" required autocomplete="username" />
          </div>
          <div>
            <label for="password">Contraseña</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" />
          </div>
          <button class="btn" type="submit">Ingresar al panel</button>
          <div id="msg-login"></div>
        </form>
      </div>

      <!-- PANEL -->
      <div id="panel" class="hidden">
        <div class="tabs">
          <button class="tab activo" data-tab="reservas">Reservas de mesa</button>
          <button class="tab" data-tab="actividades">Actividades del mes</button>
          <button class="tab" data-tab="whatsapp">Mensaje de WhatsApp</button>
        </div>

        <div id="tab-reservas">
          <div id="msg-reservas" role="status" aria-live="polite"></div>
          <div class="card" style="overflow-x: auto;">
            <table class="admin" id="tabla-reservas">
              <thead>
                <tr><th>Fecha</th><th>Hora</th><th>Nombre</th><th>WhatsApp</th><th>Pers.</th><th>Ubicación</th><th>Motivo</th><th>Estado</th><th>Contacto</th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <div id="tab-actividades" class="hidden">
          <div class="card" style="margin-bottom: 24px;">
            <h3 id="form-act-titulo">Nueva actividad</h3>
            <form id="form-actividad" class="campo-grupo">
              <input type="hidden" id="act-id" />
              <div class="fila fila-2">
                <div>
                  <label for="act-titulo">Nombre</label>
                  <input id="act-titulo" required maxlength="150" placeholder="🎨 Taller de cajitas musicales" />
                </div>
                <div>
                  <label for="act-imagen">URL de imagen</label>
                  <input id="act-imagen" placeholder="https://..." />
                </div>
              </div>
              <div>
                <label for="act-desc">Descripción</label>
                <textarea id="act-desc" rows="2" maxlength="500"></textarea>
              </div>
              <div class="fila fila-3">
                <div>
                  <label for="act-fecha">Fecha y hora</label>
                  <input id="act-fecha" type="datetime-local" required />
                </div>
                <div>
                  <label for="act-precio">Precio (S/)</label>
                  <input id="act-precio" type="number" min="0" step="0.01" required value="0" />
                </div>
                <div>
                  <label for="act-cupos">Cupos totales</label>
                  <input id="act-cupos" type="number" min="1" required value="10" />
                </div>
              </div>
              <div style="display:flex; gap:10px; align-items:center;">
                <button class="btn" type="submit">Guardar</button>
                <button class="btn btn-sec" type="button" id="btn-limpiar-act">Limpiar</button>
                <label class="nota" style="display:flex; gap:6px; align-items:center;">
                  <input type="checkbox" id="act-activa" checked style="width:auto;" /> Visible en la web
                </label>
              </div>
              <div id="msg-act"></div>
            </form>
          </div>
          <div class="card" style="overflow-x: auto;">
            <table class="admin" id="tabla-actividades">
              <thead>
                <tr><th>Actividad</th><th>Fecha</th><th>Precio</th><th>Cupos</th><th>Visible</th><th>Acciones</th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <div id="tab-whatsapp" class="hidden">
          <div class="whatsapp-settings">
            <div class="whatsapp-editor card">
              <h2>Un mensaje con tu voz.</h2>
              <p>Escribe el texto que abrirá WhatsApp desde cada reserva. Combina tus palabras con variables que toman los datos de esa persona.</p>
              <form id="form-whatsapp" class="campo-grupo">
                <label for="whatsapp-template">Mensaje para confirmar reservas</label>
                <textarea id="whatsapp-template" rows="8" maxlength="2000" required aria-describedby="whatsapp-help" placeholder="Hola {nombre}, queremos confirmar tu reserva..."></textarea>
                <p id="whatsapp-help" class="nota">Pulsa una variable para insertarla donde esté el cursor. Puedes quitar, repetir o mover cualquier dato. El botón de cada reserva usará el último mensaje guardado.</p>
                <div id="whatsapp-fields" class="whatsapp-fields" aria-label="Variables disponibles"></div>
                <div class="whatsapp-save-row">
                  <button class="btn" type="submit" id="btn-guardar-whatsapp">Guardar mensaje</button>
                  <span id="whatsapp-dirty" class="nota hidden">Tienes cambios sin guardar</span>
                </div>
                <div id="msg-whatsapp" role="status" aria-live="polite"></div>
              </form>
            </div>
            <aside class="whatsapp-preview" aria-label="Vista previa del mensaje">
              <h3>Así se verá</h3>
              <p id="whatsapp-preview-source" class="nota">Vista previa</p>
              <div id="whatsapp-preview-text" class="whatsapp-bubble">Carga una reserva para ver el mensaje.</div>
              <p class="nota">El texto se abre listo para enviar; tú decides cuándo enviarlo.</p>
            </aside>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script define:vars={{ API }}>
    const api = API.replace(/\/$/, "");
    const token = () => localStorage.getItem("inspirarte_admin_token");
    const authHeaders = () => ({ "Content-Type": "application/json", "Authorization": "Bearer " + token() });
    const ubicacionTxt = { salon: "Salón", mampara: "Mampara", barra: "Barra" };
    const motivoTxt = { cafeteria: "Cafetería", cumpleanos: "Cumpleaños", aniversario: "Aniversario", reunion: "Reunión", experiencia: "Experiencia", otro: "Otro" };
    const whatsappFields = [
      ["nombre", "Nombre"], ["fecha", "Día"], ["hora", "Hora"], ["personas", "Personas"], ["duracion", "Duración"],
      ["ubicacion", "Ubicación"], ["motivo", "Motivo"], ["motivo_detalle", "Detalle del motivo"],
      ["estado", "Estado"], ["whatsapp", "Número"], ["id", "Código"], ["creada_el", "Fecha de solicitud"],
    ];
    const money = (n) => "S/ " + Number(n).toFixed(2);
    const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[char]);
    function mostrarAviso(el, tipo, texto) {
      const aviso = document.createElement("div");
      aviso.className = `alerta ${tipo}`;
      aviso.textContent = texto;
      el.replaceChildren(aviso);
    }

    const loginBox = document.getElementById("login-box");
    const panel = document.getElementById("panel");
    const btnSalir = document.getElementById("btn-salir");

    function mostrarPanel(on) {
      loginBox.classList.toggle("hidden", on);
      panel.classList.toggle("hidden", !on);
      btnSalir.classList.toggle("hidden", !on);
    }

    document.getElementById("form-login").addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(e.target).entries());
      const msg = document.getElementById("msg-login");
      try {
        const r = await fetch(api + "/api/admin/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || "Credenciales inválidas");
        localStorage.setItem("inspirarte_admin_token", j.token);
        mostrarPanel(true);
        cargarReservas();
        cargarActividades();
        cargarPlantilla();
      } catch (err) {
        mostrarAviso(msg, "error", err.message);
      }
    });

    btnSalir.addEventListener("click", () => {
      localStorage.removeItem("inspirarte_admin_token");
      mostrarPanel(false);
    });

    // Tabs
    document.querySelectorAll(".tab").forEach((t) => {
      t.addEventListener("click", () => {
        document.querySelectorAll(".tab").forEach((x) => x.classList.remove("activo"));
        t.classList.add("activo");
        document.getElementById("tab-reservas").classList.toggle("hidden", t.dataset.tab !== "reservas");
        document.getElementById("tab-actividades").classList.toggle("hidden", t.dataset.tab !== "actividades");
        document.getElementById("tab-whatsapp").classList.toggle("hidden", t.dataset.tab !== "whatsapp");
      });
    });

    // ---- Reservas ----
    let reservasCache = [];
    let savedWhatsAppTemplate = null;
    const whatsappEditor = document.getElementById("whatsapp-template");
    const whatsappFieldsBox = document.getElementById("whatsapp-fields");
    const formatFecha = (fecha) => {
      const [year, month, day] = String(fecha || "").split("-").map(Number);
      if (!year || !month || !day) return String(fecha || "");
      return new Date(Date.UTC(year, month - 1, day)).toLocaleDateString("es-PE", { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
    };
    const templateData = (x) => ({
      nombre: x.nombre, whatsapp: x.whatsapp, fecha: formatFecha(x.fecha), hora: String(x.hora || "").slice(0, 5),
      personas: x.personas, duracion: x.duracion_min ? `${Math.floor(x.duracion_min / 60)} h ${String(x.duracion_min % 60).padStart(2, "0")} min` : "",
      ubicacion: ubicacionTxt[x.ubicacion] || x.ubicacion,
      motivo: motivoTxt[x.motivo] || x.motivo, motivo_detalle: x.motivo_detalle || "",
      estado: x.estado, id: x.id,
      creada_el: x.created_at ? new Date(x.created_at).toLocaleString("es-PE", { timeZone: "America/Lima", dateStyle: "long", timeStyle: "short" }) : "",
    });
    const renderWhatsAppMessage = (template, x) => {
      const data = templateData(x);
      return template.replace(/\{([a-z_]+)\}/g, (match, key) => Object.hasOwn(data, key) ? String(data[key] ?? "") : match);
    };
    const whatsappNumber = (value) => {
      const raw = String(value || "").trim();
      if (!/^\+?[\d\s().-]+$/.test(raw)) return "";
      let digits = raw.replace(/\D/g, "");
      if (digits.startsWith("00")) digits = digits.slice(2);
      if (/^9\d{8}$/.test(digits)) digits = "51" + digits;
      return /^\d{8,15}$/.test(digits) ? digits : "";
    };
    const whatsappLink = (x) => {
      const number = whatsappNumber(x.whatsapp);
      if (!number || savedWhatsAppTemplate === null) return "";
      return `https://wa.me/${number}?text=${encodeURIComponent(renderWhatsAppMessage(savedWhatsAppTemplate, x))}`;
    };

    function actualizarVistaPrevia() {
      const source = document.getElementById("whatsapp-preview-source");
      const preview = document.getElementById("whatsapp-preview-text");
      const reservation = reservasCache[0];
      source.textContent = reservation ? `Vista previa con la reserva de ${reservation.nombre}` : "Vista previa";
      preview.textContent = reservation ? renderWhatsAppMessage(whatsappEditor.value, reservation) : "Cuando llegue una reserva, aquí verás el mensaje con sus datos.";
      document.getElementById("whatsapp-dirty").classList.toggle("hidden", whatsappEditor.value.trim() === savedWhatsAppTemplate);
    }

    whatsappFields.forEach(([key, label]) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "whatsapp-field";
      button.textContent = `${label} · {${key}}`;
      button.setAttribute("aria-label", `Insertar ${label}`);
      button.addEventListener("click", () => {
        const start = whatsappEditor.selectionStart;
        const end = whatsappEditor.selectionEnd;
        const token = `{${key}}`;
        whatsappEditor.setRangeText(token, start, end, "end");
        whatsappEditor.focus();
        actualizarVistaPrevia();
      });
      whatsappFieldsBox.append(button);
    });
    whatsappEditor.addEventListener("input", actualizarVistaPrevia);

    async function cargarPlantilla() {
      const msg = document.getElementById("msg-whatsapp");
      try {
        const r = await fetch(api + "/api/admin/whatsapp-template", { headers: authHeaders() });
        if (r.status === 401) return mostrarPanel(false);
        if (!r.ok) throw new Error("No se pudo cargar el mensaje. Recarga el panel para intentarlo.");
        const result = await r.json();
        savedWhatsAppTemplate = result.template;
        whatsappEditor.value = result.template;
        actualizarVistaPrevia();
        renderReservas();
      } catch (err) {
        mostrarAviso(msg, "error", err.message);
      }
    }

    document.getElementById("form-whatsapp").addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = document.getElementById("msg-whatsapp");
      const button = document.getElementById("btn-guardar-whatsapp");
      button.disabled = true;
      try {
        const r = await fetch(api + "/api/admin/whatsapp-template", {
          method: "PUT", headers: authHeaders(), body: JSON.stringify({ template: whatsappEditor.value }),
        });
        const result = await r.json();
        if (!r.ok) throw new Error(result.error || "No se pudo guardar el mensaje");
        savedWhatsAppTemplate = result.template;
        whatsappEditor.value = result.template;
        actualizarVistaPrevia();
        renderReservas();
        mostrarAviso(msg, "ok", "Mensaje guardado. Los botones de las reservas ya usan esta versión.");
      } catch (err) {
        mostrarAviso(msg, "error", err.message);
      } finally {
        button.disabled = false;
      }
    });

    async function cargarReservas() {
      const tb = document.querySelector("#tabla-reservas tbody");
      const msg = document.getElementById("msg-reservas");
      const r = await fetch(api + "/api/admin/reservations", { headers: authHeaders() });
      if (r.status === 401) return mostrarPanel(false);
      if (!r.ok) return mostrarAviso(msg, "error", "No pudimos cargar las reservas. Recarga el panel para intentarlo otra vez.");
      reservasCache = await r.json();
      renderReservas();
      actualizarVistaPrevia();
    }

    function renderReservas() {
      const tb = document.querySelector("#tabla-reservas tbody");
      const msg = document.getElementById("msg-reservas");
      tb.innerHTML = reservasCache.map((x) => `
        <tr>
          <td>${escapeHtml(x.fecha)}</td><td>${escapeHtml(x.hora.slice(0, 5))}</td>
          <td>${escapeHtml(x.nombre)}</td><td>${escapeHtml(x.whatsapp)}</td><td>${escapeHtml(x.personas)}</td>
          <td>${escapeHtml(ubicacionTxt[x.ubicacion] || x.ubicacion)}</td>
          <td>${escapeHtml(motivoTxt[x.motivo] || x.motivo)}${x.motivo_detalle ? " — " + escapeHtml(x.motivo_detalle) : ""}</td>
          <td>
            <select data-id="${escapeHtml(x.id)}" data-saved="${escapeHtml(x.estado)}" class="estado-sel" aria-label="Estado de reserva de ${escapeHtml(x.nombre)}">
              ${["pendiente", "confirmada", "cancelada", "liberada"].map((e) => `<option ${e === x.estado ? "selected" : ""}>${e}</option>`).join("")}
            </select>
          </td>
          <td>${whatsappLink(x) ? `<a class="btn-whatsapp" href="${escapeHtml(whatsappLink(x))}" target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp a ${escapeHtml(x.nombre)}">Escribir</a>` : `<span class="nota">${savedWhatsAppTemplate === null ? "Cargando…" : "Número inválido"}</span>`}</td>
        </tr>`).join("") || `<tr><td colspan="9" class="nota">Sin reservas todavía.</td></tr>`;
      tb.querySelectorAll(".estado-sel").forEach((s) => {
        s.addEventListener("change", async () => {
          const anterior = s.dataset.saved;
          s.disabled = true;
          try {
            const respuesta = await fetch(api + "/api/admin/reservations/" + s.dataset.id, {
              method: "PATCH",
              headers: authHeaders(),
              body: JSON.stringify({ estado: s.value }),
            });
            if (!respuesta.ok) throw new Error("No se pudo actualizar el estado");
            s.dataset.saved = s.value;
            const reserva = reservasCache.find((x) => x.id === s.dataset.id);
            if (reserva) reserva.estado = s.value;
            renderReservas();
            actualizarVistaPrevia();
            mostrarAviso(msg, "ok", "Estado de la reserva actualizado.");
          } catch {
            s.value = anterior;
            mostrarAviso(msg, "error", "No se guardó el cambio. Inténtalo de nuevo.");
          } finally {
            s.disabled = false;
          }
        });
      });
    }

    // ---- Actividades ----
    let actsCache = [];
    async function cargarActividades() {
      const tb = document.querySelector("#tabla-actividades tbody");
      const r = await fetch(api + "/api/admin/activities", { headers: authHeaders() });
      if (r.status === 401) return mostrarPanel(false);
      actsCache = await r.json();
      tb.innerHTML = actsCache.map((a) => `
        <tr>
          <td><strong>${escapeHtml(a.titulo)}</strong></td>
          <td>${escapeHtml(new Date(a.fecha_hora).toLocaleString("es-PE", { dateStyle: "short", timeStyle: "short" }))}</td>
          <td>${escapeHtml(money(a.precio))}</td>
          <td>${escapeHtml(a.cupos_disponibles)}/${escapeHtml(a.cupos_totales)}</td>
          <td>${a.activa ? "✅" : "🚫"}</td>
          <td>
            <button class="btn btn-sec" style="padding:6px 14px;" data-editar="${escapeHtml(a.id)}">Editar</button>
            <button class="btn btn-sec" style="padding:6px 14px;" data-borrar="${escapeHtml(a.id)}">Retirar</button>
          </td>
        </tr>`).join("") || `<tr><td colspan="6" class="nota">Sin actividades. Crea la primera arriba ✨</td></tr>`;
      tb.querySelectorAll("[data-editar]").forEach((b) => b.addEventListener("click", () => editarActividad(b.dataset.editar)));
      tb.querySelectorAll("[data-borrar]").forEach((b) => b.addEventListener("click", async () => {
        if (!confirm("¿Retirar esta actividad de la web?")) return;
        await fetch(api + "/api/admin/activities/" + b.dataset.borrar, { method: "DELETE", headers: authHeaders() });
        cargarActividades();
      }));
    }

    function editarActividad(id) {
      const a = actsCache.find((x) => x.id === id);
      if (!a) return;
      document.getElementById("form-act-titulo").textContent = "Editar actividad";
      document.getElementById("act-id").value = a.id;
      document.getElementById("act-titulo").value = a.titulo;
      document.getElementById("act-imagen").value = a.imagen_url || "";
      document.getElementById("act-desc").value = a.descripcion || "";
      const d = new Date(a.fecha_hora);
      document.getElementById("act-fecha").value = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      document.getElementById("act-precio").value = a.precio;
      document.getElementById("act-cupos").value = a.cupos_totales;
      document.getElementById("act-activa").checked = a.activa;
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    document.getElementById("btn-limpiar-act").addEventListener("click", () => {
      document.getElementById("form-actividad").reset();
      document.getElementById("act-id").value = "";
      document.getElementById("form-act-titulo").textContent = "Nueva actividad";
    });

    document.getElementById("form-actividad").addEventListener("submit", async (e) => {
      e.preventDefault();
      const msg = document.getElementById("msg-act");
      const id = document.getElementById("act-id").value;
      const body = {
        titulo: document.getElementById("act-titulo").value.trim(),
        imagen_url: document.getElementById("act-imagen").value.trim(),
        descripcion: document.getElementById("act-desc").value.trim(),
        fecha_hora: new Date(document.getElementById("act-fecha").value).toISOString(),
        precio: Number(document.getElementById("act-precio").value),
        cupos_totales: Number(document.getElementById("act-cupos").value),
        activa: document.getElementById("act-activa").checked,
      };
      try {
        const r = await fetch(api + "/api/admin/activities" + (id ? "/" + id : ""), {
          method: id ? "PATCH" : "POST",
          headers: authHeaders(),
          body: JSON.stringify(body),
        });
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || "No se pudo guardar");
        mostrarAviso(msg, "ok", "Actividad guardada.");
        document.getElementById("btn-limpiar-act").click();
        cargarActividades();
      } catch (err) {
        mostrarAviso(msg, "error", err.message);
      }
    });

    if (token()) {
      mostrarPanel(true);
      cargarReservas();
      cargarActividades();
      cargarPlantilla();
    }
  </script>
</Layout>
