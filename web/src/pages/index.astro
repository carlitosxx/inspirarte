---
import Layout from "../layouts/Layout.astro";
import "../styles/home.css";
import instagramPosts from "../instagram-posts.json";

const API = import.meta.env.PUBLIC_API_URL || "http://localhost:8080";
const WHATSAPP = "51904774329";
---

<Layout title="Inspirarte Espacio — Café, creatividad y momentos para compartir">
  <header class="top">
    <nav aria-label="Navegación principal">
      <a class="logo" href="#inicio" aria-label="Inspirarte Espacio — inicio"><img src="/inspirarte-logo-web.svg" alt="Inspirarte Espacio" /></a>
      <div class="links">
        <a href="#experiencias">La experiencia</a>
        <a href="#actividades">Actividad del mes</a>
        <a href="#visitanos">Visítanos</a>
        <a class="btn" href="#reservar"><span class="booking-label">Reserva una mesa</span><span class="booking-short">Reservar</span><span aria-hidden="true">↗</span></a>
      </div>
      <details class="mobile-menu">
        <summary aria-label="Abrir menú">Menú</summary>
        <div class="mobile-menu-links">
          <a href="#experiencias">La experiencia</a>
          <a href="#actividades">Actividad del mes</a>
          <a href="#visitanos">Visítanos</a>
          <a href="#reservar">Reservar mesa</a>
        </div>
      </details>
    </nav>
  </header>

  <main id="inicio">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title">Un café.<br />Mil formas de <em>crear.</em></h1>
          <p>Un lugar para conversar sin prisa, hacer algo con tus manos y celebrar lo que te hace bien. Ven por un café; quédate por la inspiración.</p>
          <div class="hero-actions">
            <a class="btn btn-bright" href="#reservar">Quiero reservar una mesa <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#actividades">Ver actividades <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-footnote"><span class="hero-line" aria-hidden="true"></span> Cafetería · talleres · celebraciones</div>
        </div>
        <figure class="hero-visual">
          <img src="/img/tarde-creativa.webp" alt="Café y materiales de arte sobre una mesa creativa" width="1536" height="1024" fetchpriority="high" />
          <figcaption>Un espacio para dejar que las ideas fluyan <span>Imagen ilustrativa</span></figcaption>
        </figure>
      </div>
    </section>

    <section id="experiencias" class="experiencias section-space" aria-labelledby="experiencias-title">
      <div class="wrap">
        <div class="section-intro">
          <h2 id="experiencias-title">Aquí siempre hay<br /><em>algo por hacer.</em></h2>
          <p>Cada visita puede ser distinta. Elige un café tranquilo, una tarde de taller o una ocasión para reunir a los tuyos.</p>
        </div>
        <div class="experiencias-grid">
          <article>
          <span class="exp-mark">CAFÉ</span>
            <h3>Una pausa rica</h3>
            <p>Una mesa, un cafecito y tiempo para conversar o simplemente estar.</p>
          </article>
          <article>
          <span class="exp-mark">TALLERES</span>
            <h3>Manos a la obra</h3>
            <p>Experiencias y talleres para probar algo nuevo y llevarte lo que creaste.</p>
          </article>
          <article>
          <span class="exp-mark">ENCUENTROS</span>
            <h3>Momentos juntos</h3>
            <p>Cumpleaños, reuniones y celebraciones que merecen un lugar especial.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="reservar" class="reserva section-space" aria-labelledby="reserva-title">
      <div class="wrap reserva-grid">
        <div class="reserva-copy">
          <h2 id="reserva-title">Tu próxima<br /><em>mesa</em> te espera.</h2>
          <p>Cuéntanos cuándo vienes y con quién. Registramos tu solicitud y te confirmamos la reserva por WhatsApp.</p>
          <div class="reserva-notas">
            <div><strong>01 / Elige tu momento</strong><span>Fecha, hora y número de personas.</span></div>
            <div><strong>02 / Cuéntanos el plan</strong><span>Así podemos recibirte mejor.</span></div>
            <div><strong>03 / Te contactamos</strong><span>Confirmación por WhatsApp.</span></div>
          </div>
        </div>
        <div class="form-shell">
          <div class="form-heading"><h3>Reserva tu mesa</h3><span>Todos los campos son necesarios</span></div>
          <form id="form-reserva" class="campo-grupo">
            <div>
              <label for="nombre">Nombre completo</label>
              <input id="nombre" name="nombre" required maxlength="120" autocomplete="name" placeholder="Tu nombre" />
            </div>
            <div class="fila fila-2">
              <div>
                <label for="whatsapp">WhatsApp de contacto</label>
                <input id="whatsapp" name="whatsapp" type="tel" inputmode="tel" required maxlength="30" autocomplete="tel" placeholder="987 654 321" />
              </div>
              <div>
                <label for="personas">Número de personas</label>
                <input id="personas" name="personas" type="number" min="1" max="60" required value="2" />
              </div>
            </div>
            <div class="fila fila-2">
              <div>
                <label for="fecha">Fecha de reserva</label>
                <input id="fecha" name="fecha" type="date" required aria-describedby="reserva-ayuda" />
              </div>
              <div>
                <label for="hora">Hora de reserva</label>
                <input id="hora" name="hora" type="time" required aria-describedby="reserva-ayuda" />
              </div>
            </div>
            <p id="reserva-ayuda" class="nota reserva-ayuda">Lunes a viernes: 5:00 p. m. – 10:00 p. m. · Sábados: 10:00 a. m. – 10:00 p. m. · Domingos: solo grupos o celebraciones especiales con reserva previa.</p>
            <div>
              <label for="ubicacion">¿Dónde prefieres sentarte?</label>
              <select id="ubicacion" name="ubicacion" required>
                <option value="salon">Mesa en salón</option>
                <option value="mampara">Mesa junto a la mampara (máx. 2 personas)</option>
                <option value="barra">Barra junto a la ventana</option>
              </select>
            </div>
            <div>
              <label for="motivo">Motivo de tu visita</label>
              <select id="motivo" name="motivo" required>
                <option value="cafeteria">Visita a la cafetería</option>
                <option value="cumpleanos">Cumpleaños</option>
                <option value="aniversario">Aniversario</option>
                <option value="reunion">Reunión o encuentro</option>
                <option value="experiencia">Experiencia creativa</option>
                <option value="otro">Otro (cuéntanos abajo)</option>
              </select>
            </div>
            <div id="motivo-detalle-wrap" class="hidden">
              <label for="motivo_detalle">Cuéntanos un poco más</label>
              <textarea id="motivo_detalle" name="motivo_detalle" rows="2" maxlength="300" placeholder="¿Qué te gustaría celebrar o hacer?"></textarea>
            </div>
            <button class="btn submit-btn" type="submit" id="btn-reservar">Solicitar mi reserva <span aria-hidden="true">↗</span></button>
            <p class="nota">Tienes 15 minutos de tolerancia desde la hora reservada. Si te retrasas, avísanos por WhatsApp para conservar tu mesa.</p>
            <div id="msg-reserva" role="status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </section>

    <section id="actividades" class="actividades section-space" aria-labelledby="actividades-title">
      <div class="wrap">
        <div class="section-intro section-intro-light">
          <h2 id="actividades-title">Siempre hay algo<br /><em>nuevo por descubrir.</em></h2>
          <p>Talleres y experiencias creativas con cupos limitados. Mira lo que viene y aparta tu lugar.</p>
        </div>
        <div id="carrusel" class="carrusel" aria-live="polite"></div>
        <div id="sin-actividades" class="empty-activities hidden">
          <p>La próxima experiencia se está preparando.</p>
          <span>Vuelve pronto o escríbenos para enterarte de las novedades.</span>
          <a class="text-link" href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer">Preguntar por WhatsApp <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="espacio" class="espacio section-space" aria-labelledby="espacio-title">
      <div class="wrap espacio-grid">
        <div class="espacio-art" aria-hidden="true">
          <div class="paper paper-back"></div><div class="paper paper-mid"></div>
          <div class="paper paper-front"><span>un ratito<br />para ti.</span><i></i></div>
        </div>
        <div class="espacio-copy">
          <h2 id="espacio-title">Ven como eres.<br /><em>Sal inspirado.</em></h2>
          <p>Inspirarte Espacio es una invitación a detenerte y compartir. Ya sea una tarde entre amigas, un taller o una celebración, queremos que aquí encuentres un momento para crear y disfrutar.</p>
          <a class="text-link" href="#reservar">Haz espacio en tu agenda <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="galeria" class="photo-gallery section-space hidden" aria-labelledby="gallery-title">
      <div class="photo-gallery-heading"><h2 id="gallery-title">Galería</h2><button type="button" id="gallery-pause" aria-pressed="false" aria-label="Pausar movimiento de la galería">Pausar</button></div>
      <div id="photo-gallery-track" class="photo-gallery-track" tabindex="0" role="region" aria-label="Fotografías de Inspirarte; el movimiento se pausa al colocar el cursor o enfocar la galería"></div>
    </section>

    <section id="instagram" class="instagram-section section-space" aria-labelledby="instagram-title">
      <div class="wrap instagram-wrap">
        <h2 id="instagram-title">Síguenos en<br /><em>Instagram</em></h2>
        <p class="instagram-intro">Creatividad, encuentros y momentos para compartir.<br />Una selección de <a href="https://www.instagram.com/inspirarte_feriacreativa/" target="_blank" rel="noopener noreferrer">@inspirarte_feriacreativa</a>.</p>
        <div class="instagram-grid">
          {instagramPosts.map((post) => (
            <a class="instagram-post" href={post.href} target="_blank" rel="noopener noreferrer" aria-label={`${post.alt}. Abrir en Instagram (nueva pestaña)`}>
              <img src={post.image} alt={post.alt} width="640" height="640" loading="lazy" decoding="async" />
              <span class="instagram-post-overlay" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none" /></svg>
                <span>Ver publicación ↗</span>
              </span>
            </a>
          ))}
        </div>
        <a class="btn btn-sec instagram-profile" href="https://www.instagram.com/inspirarte_feriacreativa/" target="_blank" rel="noopener noreferrer">Ver más en Instagram <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section id="visitanos" class="visitanos section-space" aria-labelledby="visitanos-title">
      <div class="wrap">
        <div class="visitanos-top"><h2 id="visitanos-title">Nos vemos<br /><em>muy pronto.</em></h2><p>Estamos listos para recibirte con un cafecito y muchas ganas de crear.</p></div>
        <div class="visitanos-grid">
          <div class="info-panel">
            <h3>¿Cuándo abrimos?</h3>
            <dl class="horario">
              <div><dt>Lunes a viernes</dt><dd>5:00 p. m. – 10:00 p. m.</dd></div>
              <div><dt>Sábados</dt><dd>10:00 a. m. – 10:00 p. m.</dd></div>
              <div><dt>Domingos</dt><dd>Con reserva previa*</dd></div>
            </dl>
            <p class="nota">*Domingos: atención únicamente con reserva previa para grupos o celebraciones especiales.</p>
          </div>
          <div class="info-panel contact-panel">
            <h3>Hablemos de tu plan.</h3>
            <p>¿Tienes una duda sobre tu reserva o quieres organizar una celebración especial?</p>
            <a class="phone" href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer">904 774 329 <span aria-hidden="true">↗</span></a>
            <p class="nota">Escríbenos por WhatsApp y lo vemos juntos.</p>
          </div>
        </div>
        <details class="conditions"><summary>Información sobre el tiempo de permanencia</summary><p>Reserva regular de cafetería: hasta 2 horas y 30 minutos. Celebraciones: hasta 3 horas. Experiencias o talleres: según la duración programada. El tiempo máximo aplica principalmente cuando exista otra reserva posterior.</p></details>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div><a class="footer-logo" href="#inicio">inspirarte<span>espacio.</span></a><p>Un lugar para crear, celebrar y compartir.</p></div>
      <div class="footer-links"><a href="#reservar">Reservar mesa</a><a href="#actividades">Actividad del mes</a><a href="#visitanos">Horarios y contacto</a><a href="#instagram">Instagram</a></div>
      <div class="footer-bottom"><span>Inspirarte Espacio · Perú</span><a href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer">WhatsApp 904 774 329</a></div>
    </div>
  </footer>
  <script define:vars={{ API }}>
    const api = API.replace(/\/$/, "");
    const fmtFecha = (iso) => new Date(iso).toLocaleString("es-PE", { dateStyle: "medium", timeStyle: "short" });
    const money = (n) => "S/ " + Number(n).toFixed(2);

    // Mostrar/ocultar detalle de motivo
    const motivoSel = document.getElementById("motivo");
    const detalleWrap = document.getElementById("motivo-detalle-wrap");
    const detalleInput = document.getElementById("motivo_detalle");
    const fechaInput = document.getElementById("fecha");
    const horaInput = document.getElementById("hora");
    const personasInput = document.getElementById("personas");
    const ubicacionInput = document.getElementById("ubicacion");
    const reservaAyuda = document.getElementById("reserva-ayuda");
    const ayudaBase = reservaAyuda.textContent;

    function actualizarReglasReserva() {
      const otro = motivoSel.value === "otro";
      detalleWrap.classList.toggle("hidden", !otro);
      detalleInput.required = otro;

      const dia = fechaInput.value ? new Date(`${fechaInput.value}T12:00:00`).getDay() : null;
      const esSabado = dia === 6;
      const esDomingo = dia === 0;
      const especial = ["cumpleanos", "aniversario", "reunion", "experiencia"].includes(motivoSel.value) || Number(personasInput.value) >= 6;
      horaInput.min = esDomingo || dia === null ? "" : esSabado ? "10:00" : "17:00";
      horaInput.max = esDomingo || dia === null ? "" : "22:00";
      fechaInput.setCustomValidity(esDomingo && !especial ? "Los domingos atendemos solo grupos de 6 o más personas o celebraciones y experiencias especiales." : "");
      ubicacionInput.setCustomValidity(ubicacionInput.value === "mampara" && Number(personasInput.value) > 2 ? "La mesa junto a la mampara es para máximo 2 personas." : "");
      reservaAyuda.textContent = esDomingo
        ? "Domingos: solo grupos de 6 o más personas o celebraciones y experiencias especiales, con reserva previa. Coordina la hora por WhatsApp."
        : dia !== null ? `Horario para ${esSabado ? "sábado" : "lunes a viernes"}: ${esSabado ? "10:00 a. m." : "5:00 p. m."} – 10:00 p. m.` : ayudaBase;
    }
    [motivoSel, fechaInput, personasInput, ubicacionInput].forEach((el) => el.addEventListener("change", actualizarReglasReserva));
    personasInput.addEventListener("input", actualizarReglasReserva);
    actualizarReglasReserva();

    // La fecha del local, sin el desfase UTC de la tarde en Perú.
    fechaInput.min = new Intl.DateTimeFormat("en-CA", {
      timeZone: "America/Lima", year: "numeric", month: "2-digit", day: "2-digit",
    }).format(new Date());

    function alerta(el, tipo, texto) {
      const aviso = document.createElement("div");
      aviso.className = `alerta ${tipo}`;
      aviso.textContent = texto;
      el.replaceChildren(aviso);
    }
    const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
    })[char]);

    // ---- Reserva de mesa ----
    document.getElementById("form-reserva").addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("btn-reservar");
      const msg = document.getElementById("msg-reserva");
      btn.disabled = true;
      const data = Object.fromEntries(new FormData(e.target).entries());
      data.personas = Number(data.personas);
      try {
        const r = await fetch(api + "/api/reservations", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const j = await r.json();
        if (!r.ok) throw new Error(j.error || "No se pudo registrar la reserva");
        alerta(msg, "ok", `${j.mensaje} Recuerda: tienes 15 minutos de tolerancia desde las ${data.hora}.`);
        e.target.reset();
        actualizarReglasReserva();
      } catch (err) {
        alerta(msg, "error", "⚠️ " + err.message);
      } finally {
        btn.disabled = false;
      }
    });

    async function cargarGaleria() {
      try {
        const response = await fetch(api + "/api/gallery");
        if (!response.ok) return;
        const photos = await response.json();
        if (!photos.length) return;
        const track = document.getElementById("photo-gallery-track");
        const section = document.getElementById("galeria");
        section.classList.remove("hidden");
        const photoMarkup = photo => `<figure><img src="${escapeHtml(api + photo.imagen_url)}" alt="${escapeHtml(photo.descripcion)}" loading="lazy" decoding="async" /></figure>`;
        const unique = photos.map(photoMarkup).join("");
        const repetitions = Math.max(1, Math.ceil((Math.max(window.innerWidth, window.screen.width, 2560) + 400) / (photos.length * 220)));
        const filled = unique + Array.from({length: repetitions - 1}, () => `<div class="gallery-fill" aria-hidden="true">${unique}</div>`).join("");
        track.innerHTML = `<div class="gallery-marquee"><div class="gallery-marquee-set">${filled}</div><div class="gallery-marquee-set gallery-copy" aria-hidden="true">${filled}</div></div>`;
        const marquee = track.querySelector(".gallery-marquee");
        const set = track.querySelector(".gallery-marquee-set");
        const resize = new ResizeObserver(() => marquee.style.setProperty("--gallery-duration", `${set.getBoundingClientRect().width / 28}s`));
        resize.observe(set);
        let visible = false;
        let paused = false;
        const sync = () => marquee.classList.toggle("is-paused", paused || !visible || document.hidden);
        const observer = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }, {threshold: 0});
        observer.observe(section);
        document.addEventListener("visibilitychange", sync);
        const pause = document.getElementById("gallery-pause");
        pause.addEventListener("click", () => {
          paused = !paused;
          pause.textContent = paused ? "Reanudar" : "Pausar";
          pause.setAttribute("aria-pressed", String(paused));
          pause.setAttribute("aria-label", `${paused ? "Reanudar" : "Pausar"} movimiento de la galería`);
          sync();
        });
        sync();
      } catch { /* La galería opcional no bloquea las reservas. */ }
    }
    cargarGaleria();

    // ---- Actividades del mes ----
    async function cargarActividades() {
      const carrusel = document.getElementById("carrusel");
      try {
        const r = await fetch(api + "/api/activities");
        if (!r.ok) throw new Error("No se pudieron cargar las actividades");
        const acts = await r.json();
        if (!acts.length) {
          document.getElementById("sin-actividades").classList.remove("hidden");
          return;
        }
        carrusel.innerHTML = acts.map((a) => `
          <article class="actividad" data-id="${escapeHtml(a.id)}">
            ${a.imagen_url ? `<img src="${escapeHtml(a.imagen_url.startsWith("/media/activities/") ? api + a.imagen_url : a.imagen_url)}" alt="${escapeHtml(a.titulo)}" loading="lazy" />` : ""}
            <div class="cuerpo">
              <h3>${escapeHtml(a.titulo)}</h3>
              <time class="activity-date" datetime="${escapeHtml(a.fecha_hora)}">${escapeHtml(fmtFecha(a.fecha_hora))}</time>
              ${a.descripcion ? `<div class="activity-description"><p id="description-${escapeHtml(a.id)}" class="activity-description-text">${escapeHtml(a.descripcion)}</p>${a.descripcion.length > 220 ? `<button class="activity-description-toggle" type="button" aria-expanded="false" aria-controls="description-${escapeHtml(a.id)}">Leer descripción completa <span aria-hidden="true">+</span></button>` : ""}</div>` : ""}
              <div class="activity-booking-info"><div class="precio"><span>Por persona</span>${money(a.precio)}</div>
              <div class="cupos ${a.agotado ? "agotados" : "quedan"}">
                ${a.agotado ? "Cupos agotados" : `${escapeHtml(a.cupos_disponibles)} cupos disponibles`}
              </div></div>
              ${a.agotado ? "" : `
                <button class="btn btn-apartar" aria-expanded="false" type="button">Reservar mi cupo</button>
                <form class="mini-form hidden">
                  <input name="nombre" aria-label="Nombre completo" required maxlength="120" placeholder="Nombre completo" />
                  <input name="whatsapp" aria-label="WhatsApp" type="tel" required maxlength="30" placeholder="WhatsApp" />
                  <div class="mini-form-row">
                    <input name="cupos" aria-label="Cantidad de cupos" type="number" min="1" max="${escapeHtml(a.cupos_disponibles)}" value="1" />
                    <button class="btn" type="submit">Apartar</button>
                  </div>
                </form>
                <div class="msg-cupos" role="status" aria-live="polite"></div>`}
            </div>
          </article>`).join("");

        carrusel.querySelectorAll(".actividad").forEach((card) => {
          const descriptionToggle = card.querySelector(".activity-description-toggle");
          descriptionToggle?.addEventListener("click", () => {
            const expanded = descriptionToggle.getAttribute("aria-expanded") !== "true";
            descriptionToggle.setAttribute("aria-expanded", String(expanded));
            card.querySelector(".activity-description-text").classList.toggle("expanded", expanded);
            descriptionToggle.innerHTML = expanded ? 'Ver menos <span aria-hidden="true">−</span>' : 'Leer descripción completa <span aria-hidden="true">+</span>';
          });
          const btn = card.querySelector(".btn-apartar");
          if (!btn) return;
          const form = card.querySelector(".mini-form");
          btn.addEventListener("click", () => {
            const opening = form.classList.contains("hidden");
            form.classList.toggle("hidden");
            btn.setAttribute("aria-expanded", String(opening));
            btn.textContent = opening ? "Cerrar formulario" : "Reservar mi cupo";
            if (opening) {
              if (!matchMedia("(prefers-reduced-motion: reduce)").matches) form.animate([{ opacity: 0, transform: "translateY(-8px)" }, { opacity: 1, transform: "translateY(0)" }], { duration: 240, easing: "ease-out" });
              form.querySelector("input").focus({ preventScroll: true });
            }
          });
          form.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (form.dataset.submitting === "true") return;
            const msg = card.querySelector(".msg-cupos");
            const submitBtn = form.querySelector('button[type="submit"]');
            const data = Object.fromEntries(new FormData(form).entries());
            data.cupos = Number(data.cupos) || 1;
            form.dataset.submitting = "true";
            submitBtn.disabled = true;
            submitBtn.textContent = "Apartando...";
            let reservado = false;
            try {
              const r = await fetch(api + "/api/activities/" + card.dataset.id + "/book", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
              });
              const j = await r.json();
              if (!r.ok) throw new Error(j.error || "No se pudo apartar tu cupo");
              alerta(msg, "ok", `¡Cupo apartado! Quedan ${j.cupos_restantes} disponibles. Te escribiremos por WhatsApp para confirmar.`);
              const cupos = card.querySelector(".cupos");
              cupos.textContent = Number(j.cupos_restantes) > 0 ? `${j.cupos_restantes} cupos disponibles` : "Cupos agotados";
              cupos.classList.toggle("quedan", Number(j.cupos_restantes) > 0);
              cupos.classList.toggle("agotados", Number(j.cupos_restantes) <= 0);
              form.classList.add("hidden");
              btn.disabled = true;
              btn.textContent = "Cupo apartado";
              reservado = true;
            } catch (err) {
              alerta(msg, "error", "⚠️ " + err.message);
            } finally {
              form.dataset.submitting = "false";
              if (!reservado) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Apartar";
              }
            }
          });
        });
      } catch {
        carrusel.innerHTML = `<p class="activities-error">No pudimos cargar las actividades por ahora. Escríbenos al WhatsApp 904 774 329.</p>`;
      }
    }
    cargarActividades();
  </script>
</Layout>
