---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Inspirarte Espacio: cafetería, talleres y experiencias creativas. Reserva una mesa o descubre las actividades del mes." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#33243b" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght,SOFT,WONK@9..144,500,20,1;9..144,600,20,1;9..144,700,20,1&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        --crema: #f7f1e9;
        --crema-2: #e8dfd5;
        --blanco: #fffaf4;
        --tinta: #33243b;
        --tinta-suave: #615568;
        --ciruela: #49305a;
        --lavanda: #cbb9d9;
        --cielo: #d7e6e9;
        --manteca: #f4d58a;
        --algodon: #efc7d0;
        --periwinkle: #b5b6d4;
        --peri-mas-oscuro: #654579;
        --verde: #276f51;
        --rojo: #a93938;
        --font-display: "Fraunces", Georgia, serif;
        --font-body: "DM Sans", system-ui, sans-serif;
        --radio: 16px;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--crema); color: var(--tinta); font: 400 1rem/1.6 var(--font-body); }
      ::selection { background: var(--lavanda); color: var(--tinta); }
      :focus-visible { outline: 3px solid #9464ad; outline-offset: 3px; }
      * { scrollbar-color: #a990b7 var(--crema); }
      a { color: inherit; text-underline-offset: .2em; }
      button, input, textarea, select { font: inherit; }
      button { cursor: pointer; }
      h1, h2, h3 { margin: 0; font-family: var(--font-display); font-weight: 600; line-height: 1.08; letter-spacing: -.025em; }
      h1 { font-size: clamp(3.5rem, 6vw, 6rem); }
      h2 { font-size: clamp(2.7rem, 4.5vw, 4.7rem); }
      h3 { font-size: clamp(1.5rem, 2.2vw, 2.2rem); }
      p { margin: 0 0 1em; }
      .wrap { width: min(100% - 48px, 1200px); margin-inline: auto; }
      .hidden { display: none !important; }
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: .65rem; min-height: 50px; padding: 12px 24px; border: 1px solid var(--tinta); border-radius: 100px; background: var(--tinta); color: #fffaf4; font-weight: 700; line-height: 1.2; text-decoration: none; transition: background .2s ease, color .2s ease, transform .2s ease; }
      .btn:hover { background: var(--ciruela); transform: translateY(-2px); }
      .btn:disabled { opacity: .55; cursor: not-allowed; transform: none; }
      .btn-sec { background: transparent; color: var(--tinta); }
      .btn-sec:hover { background: var(--tinta); color: #fffaf4; }
      .card { background: var(--blanco); border-radius: var(--radio); padding: clamp(22px, 3vw, 34px); box-shadow: 0 16px 44px rgba(51,36,59,.08); }
      form.campo-grupo { display: grid; gap: 18px; }
      label { display: block; margin-bottom: 7px; color: var(--tinta); font-size: .9rem; font-weight: 700; }
      input, select, textarea { width: 100%; min-height: 48px; padding: 11px 14px; border: 1px solid #cbbecb; border-radius: 9px; background: #fff; color: var(--tinta); caret-color: var(--ciruela); }
      textarea { min-height: 82px; resize: vertical; }
      input::placeholder, textarea::placeholder { color: #766b77; opacity: 1; }
      input:focus, select:focus, textarea:focus { outline: 2px solid #9464ad; outline-offset: 1px; border-color: #9464ad; }
      .fila { display: grid; gap: 16px; grid-template-columns: 1fr; }
      @media (min-width: 640px) { .fila-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .fila-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      .nota { color: var(--tinta-suave); font-size: .88rem; line-height: 1.5; }
      .alerta { padding: 14px 16px; border-radius: 10px; margin-top: 8px; font-weight: 600; }
      .alerta.ok { background: #e3f2e9; color: #175638; }
      .alerta.error { background: #fae7e5; color: #852e30; }
      .carrusel { display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px 2px 26px; }
      .actividad { flex: 0 0 min(340px, 86vw); scroll-snap-align: start; display: flex; flex-direction: column; overflow: hidden; border-radius: 14px; background: var(--blanco); color: var(--tinta); }
      .actividad img { display: block; width: 100%; height: 205px; object-fit: cover; }
      .actividad .cuerpo { display: flex; flex: 1; flex-direction: column; gap: 9px; padding: 22px; }
      .actividad h3 { font-size: 1.55rem; }
      .actividad .precio { font-size: 1.25rem; font-weight: 700; }
      .cupos { font-weight: 700; font-size: .9rem; }
      .cupos.quedan { color: var(--verde); }
      .cupos.agotados { color: var(--rojo); }
      .mini-form { display: grid; gap: 10px; margin-top: 8px; }
      .mini-form .btn { min-height: 44px; }
      header.top { position: sticky; top: 0; z-index: 30; background: rgba(247,241,233,.97); border-bottom: 1px solid var(--crema-2); }
      header.top nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: min(100% - 48px, 1200px); min-height: 78px; margin: auto; }
      header.top .logo { display: inline-flex; align-items: center; text-decoration: none; }
      header.top .logo img { display: block; height: 44px; width: auto; }
      header.top .links { display: flex; align-items: center; gap: clamp(16px, 2.2vw, 34px); }
      header.top .links a:not(.btn) { font-size: .9rem; font-weight: 700; text-decoration: none; }
      header.top .links a:not(.btn):hover { color: var(--peri-mas-oscuro); }
      table.admin { width: 100%; border-collapse: collapse; font-size: .9rem; }
      table.admin th, table.admin td { text-align: left; padding: 13px 12px; border-bottom: 1px solid var(--crema-2); }
      table.admin th { color: var(--tinta-suave); font-size: .77rem; text-transform: uppercase; letter-spacing: .07em; }
      .tabs { display: flex; gap: 10px; margin: 26px 0; flex-wrap: wrap; }
      .tab { border: 1px solid var(--crema-2); background: var(--blanco); border-radius: 100px; padding: 10px 22px; font-weight: 700; color: var(--tinta); }
      .tab.activo { background: var(--tinta); border-color: var(--tinta); color: var(--blanco); }
      @media (max-width: 800px) { header.top nav { width: min(100% - 32px, 1200px); min-height: 68px; } header.top .links a:not(.btn) { display: none; } header.top .logo img { height: 36px; } header.top .btn { min-height: 42px; padding: 9px 14px; font-size: .82rem; } }
      @media (max-width: 640px) { .wrap { width: min(100% - 32px, 1200px); } h1 { font-size: clamp(3.05rem, 14vw, 4rem); } h2 { font-size: clamp(2.55rem, 11vw, 3.5rem); } }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; } }
    </style>
  </body>
</html>
