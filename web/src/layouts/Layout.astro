---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Inspirarte Espacio — cafetería, experiencias creativas, talleres y celebraciones." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        --crema: #faf5ec;
        --crema-2: #f3e9d8;
        --tinta: #3d2b1f;
        --tinta-suave: #6f5b4a;
        --lila: #7c4dff;
        --lila-oscuro: #5e35c4;
        --rosa: #f9a8d4;
        --verde: #2f9e6e;
        --rojo: #d64545;
        --blanco: #ffffff;
        --radio: 18px;
        --sombra: 0 10px 30px rgba(61, 43, 31, 0.12);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
        background: var(--crema);
        color: var(--tinta);
        line-height: 1.6;
      }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
      section { padding: 72px 0; }
      h1, h2, h3 { line-height: 1.2; margin: 0 0 12px; }
      h2 { font-size: clamp(1.7rem, 3.5vw, 2.4rem); text-align: center; }
      .sub { text-align: center; color: var(--tinta-suave); max-width: 640px; margin: 0 auto 40px; }
      .btn {
        display: inline-block; border: 0; cursor: pointer;
        background: var(--lila); color: #fff; font-weight: 700; font-size: 1rem;
        padding: 14px 30px; border-radius: 999px; text-decoration: none;
        transition: transform .15s ease, background .15s ease;
      }
      .btn:hover { background: var(--lila-oscuro); transform: translateY(-2px); }
      .btn:disabled { background: #b9a8e8; cursor: not-allowed; transform: none; }
      .btn-sec { background: var(--blanco); color: var(--lila-oscuro); border: 2px solid var(--lila); }
      .btn-sec:hover { background: var(--lila); color: #fff; }
      .card {
        background: var(--blanco); border-radius: var(--radio);
        box-shadow: var(--sombra); padding: 28px;
      }
      form.campo-grupo { display: grid; gap: 16px; }
      label { font-weight: 600; font-size: .95rem; display: block; margin-bottom: 6px; }
      input, select, textarea {
        width: 100%; padding: 12px 14px; font-size: 1rem;
        border: 2px solid var(--crema-2); border-radius: 12px;
        background: #fff; color: var(--tinta); font-family: inherit;
      }
      input:focus, select:focus, textarea:focus {
        outline: none; border-color: var(--lila);
      }
      .fila { display: grid; gap: 16px; grid-template-columns: 1fr; }
      @media (min-width: 640px) { .fila-2 { grid-template-columns: 1fr 1fr; } .fila-3 { grid-template-columns: 1fr 1fr 1fr; } }
      .alerta { border-radius: 12px; padding: 14px 18px; margin-top: 18px; font-weight: 600; }
      .alerta.ok { background: #e6f7ee; color: #1d6b44; border: 1px solid #bfe8d2; }
      .alerta.error { background: #fdecec; color: #a02c2c; border: 1px solid #f5c6c6; }
      .nota { font-size: .9rem; color: var(--tinta-suave); }
      /* Carrusel de actividades */
      .carrusel {
        display: flex; gap: 22px; overflow-x: auto; scroll-snap-type: x mandatory;
        padding: 10px 4px 24px; scrollbar-width: thin;
      }
      .actividad {
        flex: 0 0 300px; scroll-snap-align: start;
        background: var(--blanco); border-radius: var(--radio);
        box-shadow: var(--sombra); overflow: hidden; display: flex; flex-direction: column;
      }
      .actividad img { width: 100%; height: 180px; object-fit: cover; background: var(--crema-2); }
      .actividad .cuerpo { padding: 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
      .actividad .precio { font-size: 1.25rem; font-weight: 800; color: var(--lila-oscuro); }
      .cupos { font-weight: 700; }
      .cupos.quedan { color: var(--verde); }
      .cupos.agotados { color: var(--rojo); }
      .mini-form { display: grid; gap: 10px; margin-top: 10px; }
      /* Header */
      header.top {
        position: sticky; top: 0; z-index: 50;
        background: rgba(250, 245, 236, .92); backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--crema-2);
      }
      header.top nav { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; max-width: 1120px; margin: 0 auto; }
      header.top .logo { font-weight: 800; font-size: 1.25rem; text-decoration: none; color: var(--tinta); }
      header.top .logo span { color: var(--lila); }
      header.top .links { display: flex; gap: 18px; align-items: center; }
      header.top .links a:not(.btn) { color: var(--tinta); text-decoration: none; font-weight: 600; }
      header.top .links a:not(.btn):hover { color: var(--lila-oscuro); }
      @media (max-width: 640px) { header.top .links a:not(.btn) { display: none; } }
      .hero { text-align: center; padding: 90px 0 60px; }
      .hero h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
      .hero h1 em { color: var(--lila); font-style: normal; }
      .hero p { color: var(--tinta-suave); max-width: 620px; margin: 0 auto 28px; font-size: 1.1rem; }
      .chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 26px; }
      .chip { background: var(--blanco); border: 1px solid var(--crema-2); border-radius: 999px; padding: 8px 16px; font-size: .9rem; font-weight: 600; }
      footer { background: var(--tinta); color: #f5efe4; padding: 44px 0; margin-top: 40px; }
      footer a { color: var(--rosa); }
      .horario { display: grid; gap: 8px; margin: 18px 0; }
      .horario div { display: flex; justify-content: space-between; border-bottom: 1px dashed rgba(255,255,255,.2); padding-bottom: 8px; }
      table.admin { width: 100%; border-collapse: collapse; font-size: .92rem; }
      table.admin th, table.admin td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--crema-2); }
      table.admin th { color: var(--tinta-suave); font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
      .tabs { display: flex; gap: 10px; margin: 26px 0; flex-wrap: wrap; }
      .tab { border: 2px solid var(--crema-2); background: #fff; border-radius: 999px; padding: 10px 22px; font-weight: 700; cursor: pointer; }
      .tab.activo { background: var(--lila); border-color: var(--lila); color: #fff; }
      .hidden { display: none !important; }
    </style>
  </body>
</html>
