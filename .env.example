# Copiar a .env y completar. En Coolify estas variables van en el recurso,
# no es necesario subir el archivo .env al repo.

# --- Postgres (solo desarrollo local con docker compose) ---
POSTGRES_USER=inspirarte
POSTGRES_PASSWORD=inspirarte
POSTGRES_DB=inspirarte

# --- Backend ---
# En Coolify se recomienda usar su recurso PostgreSQL gestionado y pegar aquí su URL interna.
DATABASE_URL=postgres://inspirarte:inspirarte@db:5432/inspirarte?sslmode=disable
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
ADMIN_EMAIL=admin@inspirarte.local
ADMIN_PASSWORD=cambia-esta-clave
PORT=8080

# --- Web ---
# URL pública de la API (la que verá el navegador del cliente).
# En Coolify: https://api.tu-dominio.com  (o la URL del servicio backend)
PUBLIC_API_URL=http://localhost:8080
